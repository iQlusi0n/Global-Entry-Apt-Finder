# ntfy topic URL to POST notifications to (required unless --no-notify)
NTFY_URL=https://ntfy.sh/your-secret-topic

# Optional: access token (preferred) ...
#NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ... or basic auth
#NTFY_USER=
#NTFY_PASS=

# Enrollment centers to watch, comma or space separated (see `locations`)
GE_LOCATIONS=5023,7680

# Optional: ignore slots on or after this date
#GE_BEFORE=2026-12-01

# Optional: seconds between polls (default 300)
#GE_INTERVAL=300

# Optional: where reported slots are remembered (default ./.slots.json;
# the systemd unit sets this to its StateDirectory, ~/.config/ge-apt-finder/)
#GE_STATE_FILE=
