# systemd user unit for ge-appointment-finder.
#
# All configuration lives in ~/.config/ge-appointment-finder/env (see
# .env.example); this file never needs editing. Install:
#
#   uv tool install git+https://github.com/iQlusi0n/Global-Entry-Apt-Finder
#   mkdir -p ~/.config/systemd/user ~/.config/ge-appointment-finder
#   cp contrib/ge-appointment-finder.service ~/.config/systemd/user/
#   cp .env.example ~/.config/ge-appointment-finder/env && chmod 600 ~/.config/ge-appointment-finder/env
#   $EDITOR ~/.config/ge-appointment-finder/env      # NTFY_URL, GE_LOCATIONS, ...
#   systemctl --user daemon-reload
#   systemctl --user enable --now ge-appointment-finder
#   loginctl enable-linger "$USER"                    # keep running while logged out
#
# Inspect:  systemctl --user status ge-appointment-finder
#           journalctl --user -u ge-appointment-finder -f

[Unit]
Description=Global Entry appointment finder
Documentation=https://github.com/iQlusi0n/Global-Entry-Apt-Finder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
EnvironmentFile=%h/.config/ge-appointment-finder/env
Environment=GE_STATE_FILE=%S/ge-appointment-finder/slots.json
StateDirectory=ge-appointment-finder
ExecStart=%h/.local/bin/ge-appointment-finder watch
# The service pings the watchdog once per poll; keep this above GE_INTERVAL
# plus a few minutes of slack for slow/retrying API calls.
WatchdogSec=900
Restart=on-failure
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=default.target
